pe":"file","content_type":"application/jpg","id":"832ad09c-f1d2-4d16-b05b-78ae1d2d18e0","title":"Police officer - To beckon traffic on from the front","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5eada40f0b6790f000003/police-officer-beckon-from-the-front.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"7e76ce5e-8d63-4383-b310-7a2fa9b4b393","title":"Police officer - To beckon traffic on from behind","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5eaf140f0b6790f000005/police-officer-beckon-from-behind.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"11c3c82a-6f3f-4193-bc43-5ba593fa80ca","title":"Arm signals to persons controlling traffic turning right","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5eb57ed915d07e2000001/car-arm-signals-turn-right.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"792cf117-bc9e-488f-9dd1-2163e416ae34","title":"School crossing patrols not ready to cross","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5ebf3e5274a21ec000001/school-crossing-patrol-not-ready.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"3c0bc4c6-66b8-40b2-b1b1-e710796d53bc","title":"School crossing patrols barrier to stop pedestrians crossing","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5ec22e5274a21ec000003/school-crossing-patrol-barrier-to-stop.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"8a414c10-2d4e-48fd-a481-87284735b65c","title":"School crossing patrols vehicles must be prepared to stop","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5ec4fed915d07e2000003/school-crossing-patrol-vehicle-prepare-stop.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"6852651f-0585-4b1e-be75-8e4e42b2c8b1","title":"School crossing patrols all vehicles must stop","url":"https://assets.digital.cabinet-office.gov.uk/media/55b5ec6fe5274a2152000002/school-crossing-patrol-all-vehicles-stop.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"86a7c17a-2e67-4d86-9bf8-6957d3b076bd","title":"Car arm signal - turn left","url":"https://assets.digital.cabinet-office.gov.uk/media/55cb094940f0b61374000019/car-arm-signal-turn-left.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"bd04a24b-6c9c-4b0d-9ef1-97dd17ce63c3","title":"Car arm signal - straight on","url":"https://assets.digital.cabinet-office.gov.uk/media/55cb0962e5274a547300001f/car-arm-signal-straight-on.jpg"},{"attachment_type":"file","content_type":"application/pdf","id":"bcc6da06-ace3-4fc6-bd5d-b50ca6360108","title":"Signals by authorised persons","url":"https://assets.publishing.service.gov.uk/media/560aa62bed915d035c00001b/the-highway-code-signals-by-authorised-persons.pdf"},{"attachment_type":"file","content_type":"application/jpg","id":"0bd64dc6-3762-422f-b4f2-6ce2b8bf04b1","title":"Traffic officer","url":"https://assets.publishing.service.gov.uk/media/591dd56bed915d20fb000058/traffic-officer.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"eb792e8d-1964-4edf-98ab-49730464c95e","title":"DVSA officer","url":"https://assets.publishing.service.gov.uk/media/591dd579e5274a5e4e000050/dvsa-officer.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"cdb4c697-7f39-499d-bceb-32cee9ba759a","title":"Traffic officer and car","url":"https://assets.publishing.service.gov.uk/media/591dd678ed915d20f800005b/traffic-officer-car.jpg"},{"attachment_type":"file","content_type":"application/jpg","id":"4d79f4e3-87a0-4c49-8818-69e199adc852","title":"DVSA officer and car","url":"https://assets.publishing.service.gov.uk/media/591dd688ed915d20fb00005a/dvsa-officer-car.jpg"}],"body":"\n<div class=\"form-download\">\n<p><a href=\"https://assets.digital.cabinet-office.gov.uk/media/560aa62bed915d035c00001b/the-highway-code-signals-by-authorised-persons.pdf\">Download ‘Signals by authorised persons’ (PDF, 468KB)</a></p>\n</div>\n\n<h2 id=\"policeofficers\">Police officers</h2>\n\n<h3 id=\"stop\">Stop</h3>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/559e6c97ed915d159500002e/police-officers-traffic-from-front.jpg\" alt=\"Traffic approaching from the front\"></p>\n<figcaption>Traffic approaching from the front</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/559e6cafe5274a155c00003b/police-officers-traffic-from-front-and-behind.jpg\" alt=\"Traffic approaching from both front and behind\"></p>\n<figcaption>Traffic approaching from both front and behind</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/559e6cc5e5274a155c00003d/police-officers-traffic-from-behind.jpg\" alt=\"Traffic approaching from behind\"></p>\n<figcaption>Traffic approaching from behind</figcaption>\n\n<h3 id=\"to-beckon-traffic-on\">To beckon traffic on</h3>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5eac240f0b67aa3000002/police-officer-beckon-from-the-side.jpg\" alt=\"From the side\"></p>\n<figcaption>From the side</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5eada40f0b6790f000003/police-officer-beckon-from-the-front.jpg\" alt=\"From the front\"></p>\n<figcaption>From the front</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5eaf140f0b6790f000005/police-officer-beckon-from-behind.jpg\" alt=\"From behind*\"></p>\n<figcaption>From behind*</figcaption>\n\n<p>*In Wales, bilingual signs appear on emergency services vehicles and clothing</p>\n\n<h2 id=\"personscontrol\">Arm signals to persons controlling traffic</h2>\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55cb0962e5274a547300001f/car-arm-signal-straight-on.jpg\" alt=\"I want to go straight on\"></p>\n<figcaption>I want to go straight on</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55cb094940f0b61374000019/car-arm-signal-turn-left.jpg\" alt=\"I want to turn left; use either hand\"></p>\n<figcaption>I want to turn left; use either hand</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5eb57ed915d07e2000001/car-arm-signals-turn-right.jpg\" alt=\"I want to turn right\"></p>\n<figcaption>I want to turn right</figcaption>\n\n<h2 id=\"dvsatrafficofficer\">Driver and Vehicle Standards Agency officers and traffic officers</h2>\n<p><img src=\"https://assets.publishing.service.gov.uk/media/591dd678ed915d20f800005b/traffic-officer-car.jpg\" alt=\"Traffic officer\"></p>\n<figcaption>Traffic officer</figcaption>\n\n<p><img src=\"https://assets.publishing.service.gov.uk/media/591dd688ed915d20fb00005a/dvsa-officer-car.jpg\" alt=\"DVSA officer\"></p>\n<figcaption>DVSA officer</figcaption>\n\n<p>These officers now have new powers to stop/direct vehicles and will be using hand signals and light\nsignals similar to those used by police. You <strong>MUST</strong> obey any signals given (see <a href=\"/guidance/the-highway-code/general-rules-techniques-and-advice-for-all-drivers-and-riders-103-to-158#rule107\">Rules 107</a> and <a href=\"/guidance/the-highway-code/general-rules-techniques-and-advice-for-all-drivers-and-riders-103-to-158#rule108\">108</a>).</p>\n\n<h2 id=\"schoolcrosspatrols\">School crossing patrols</h2>\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5ebf3e5274a21ec000001/school-crossing-patrol-not-ready.jpg\" alt=\"Not ready to cross pedestrians\"></p>\n<figcaption>Not ready to cross pedestrians</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5ec22e5274a21ec000003/school-crossing-patrol-barrier-to-stop.jpg\" alt=\"Barrier to stop pedestrians crossing\"></p>\n<figcaption>Barrier to stop pedestrians crossing</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5ec4fed915d07e2000003/school-crossing-patrol-vehicle-prepare-stop.jpg\" alt=\"Ready to cross pedestrians, vehicles must be prepared to stop\"></p>\n<figcaption>Ready to cross pedestrians, vehicles must be prepared to stop</figcaption>\n\n<p><img src=\"https://assets.digital.cabinet-office.gov.uk/media/55b5ec6fe5274a2152000002/school-crossing-patrol-all-vehicles-stop.jpg\" alt=\"All vehicles must stop\"></p>\n<figcaption>All vehicles must stop</figcaption>\n\n","manual":{"base_path":"/guidance/the-highway-code"},"organisations":[{"abbreviation":"DfT","title":"Department for Transport","web_url":"https://www.gov.uk/government/organisations/department-for-transport"}],"visually_expanded":false},"document_type":"manual_section","first_published_at":"2015-10-01T01:00:00+01:00","links":{"available_translations":[{"api_path":"/api/content/guidance/the-highway-code/signals-by-authorised-persons","api_url":"https://www.gov.uk/api/content/guidance/the-highway-code/signals-by-authorised-persons","base_path":"/guidance/the-highway-code/signals-by-authorised-persons","content_id":"79b9d76a-be07-4e73-9f67-bf788ffec746","document_type":"manual_section","links":{},"locale":"en","public_updated_at":"2015-10-01T00:00:00Z","schema_name":"manual_section","title":"Signals by authorised persons","web_url":"https://www.gov.uk/guidance/the-highway-code/signals-by-authorised-persons","withdrawn":false}],"manual":[{"api_path":"/api/content/guidance/the-highway-code","api_url":"https://www.gov.uk/api/content/guidance/the-highway-code","base_path":"/guidance/the-highway-code","content_id":"bbf6c11a-7dc6-4fe6-8dd8-68c09bdbe562","document_type":"manual","links":{},"locale":"en","public_updated_at":"2025-10-22T13:29:14Z","schema_name":"manual","title":"The Highway Code","web_url":"https://www.gov.uk/guidance/the-highway-code","withdrawn":false}],"organisations":[{"analytics_identifier":"D9","api_path":"/api/content/government/organisations/department-for-transport","api_url":"https://www.gov.uk/api/content/government/organisations/department-for-transport","base_path":"/government/organisations/department-for-transp